import java.util.*;
public class Nikitha_and_books {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            int n = sc.nextInt();
            long balance = 0;
            boolean possible = true;
            for (int i = 1; i <= n; i++) {
                long x = sc.nextLong();
                if (x >= i) {
                    balance += x - i;
                } else {
                    long need = i - x;
                    if (balance >= need) {
                        balance -= need;
                    } else {
                        possible = false;
                    }
                }
            }
            System.out.println(possible ? "YES" : "NO");
        }
    }
}
