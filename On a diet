import java.util.*;
public class Diet {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int m = sc.nextInt();
		int k = sc.nextInt();
		int[] arr = new int[n];
		for(int i = 0; i < n; i++) {
			arr[i] = sc.nextInt();
		}
		for(int i = 0; i < n; i++) {
			if(arr[i] < k) {
				int left = 0, sum = 0;
				for(int right = 0; right < m; right++) {
				sum+=arr[right];
				if(right - left + 1 == m) {
					sum-=arr[left];
					left++;
				}
				}
				if(sum < k) {
				System.out.println("Yes");
				}else {
					System.out.println("No");
				}
				}
		     else {
				System.out.println("No");
			}
			
		}

	}

}
