import java.util.*;
public class Two_digit_string {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int num = sc.nextInt();
		for(int i = 0; i < num; i++) {
		String str1 = sc.next();
		String str2 = sc.next();
		int l1 = str1.length();
		int l2 = str2.length();
		int[] arr1 = new int[l1];
		int[] arr2 = new int[l2];
		int[][] res = new int[l1][l2];
		arr1[0] = (str1.charAt(0)-'0')%10;
		for(int j = 1; j < l1; j++){
			arr1[j] = (arr1[j-1]+(str1.charAt(j)-'0')) % 10; 
		}
		arr2[0] = (str2.charAt(0)-'0') % 10;
		for(int k = 1; k < l2; k++) {
			arr2[k] = (arr2[k-1]+(str2.charAt(k)-'0'))% 10;
		}
		if(arr1[l1-1] != arr2[l2-1]) {
			System.out.println("-1");
		}else {
			for(int j = 0; j < l1; j++) {
				for(int k = 0; k < l2; k++) {
					if(arr1[j] == arr2[k]) {
						if(j == 0 || k == 0) {
							res[j][k] = 1;
						}else {
							res[j][k] = 1 + res[j-1][k-1];
						}
					}else {
						if(j == 0 && k == 0) {
							res[j][k] = 0;
						}else if( j == 0 && k != 0) {
							res[j][k] = res[j][k-1];
						}else if(j != 0 && k == 0) {
							res[j][k] = res[j-1][k];
						}else {
							res[j][k] = Math.max(res[j][k-1], res[j-1][k]);
						}
					}
				}
			}		
            System.out.println(res[l1-1][l2-1]);
		}
		}
	}
}
