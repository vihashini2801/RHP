import java.util.*;
public class Tallest_at_the_moment {

    static int upperBound(int[] arr, int target) {
        int left = 0;
        int right = arr.length;
        while (left < right) {
            int mid = left + (right - left) / 2;
            if (arr[mid] <= target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return left;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] height = new int[n];
        int[] leave = new int[n];
        for (int i = 0; i < n; i++) {
            height[i] = sc.nextInt();
            leave[i] = sc.nextInt();
        }
        int[] suffixMax = new int[n];
        suffixMax[n - 1] = height[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            suffixMax[i] = Math.max(height[i], suffixMax[i + 1]);
        }
        int q = sc.nextInt();
        for (int i = 0; i < q; i++) {
            int t = sc.nextInt();
            int index = upperBound(leave, t);
            System.out.println(suffixMax[index]);
        }

        sc.close();
    }
}
